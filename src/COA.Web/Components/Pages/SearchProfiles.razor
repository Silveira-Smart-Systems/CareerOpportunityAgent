@page "/search-profiles"
@attribute [Authorize]
@rendermode InteractiveServer
@using COA.Web.Api
@inject CoaApiClient Api

<PageTitle>Search preferences</PageTitle>
<h1>Search preferences</h1>
@if (loading) { <p role="status">Loading search preferences…</p> }
else {
 @if (!string.IsNullOrEmpty(error)) { <p role="alert">@error</p> }
 @if (profiles.Count == 0) { <p>No search profile exists yet.</p> } else { <ul>@foreach(var item in profiles) { <li>@item.Name (@(item.IsActive ? "active — drives matching" : "inactive")) — @string.Join(", ", item.Preferences.TargetRoles) <button @onclick="()=>Edit(item)">Edit</button> <button @onclick="()=>SetActiveAsync(item)">@(item.IsActive?"Deactivate":"Activate")</button></li> }</ul> }
 <EditForm Model="form" OnValidSubmit="SaveAsync"><DataAnnotationsValidator /><ValidationSummary />
  <label>Name <InputText @bind-Value="form.Name" /></label><label>Category <InputText @bind-Value="form.Category" /></label><label>Target role <InputText @bind-Value="form.Role" /></label><label>Market (ISO country) <InputText @bind-Value="form.Market" /></label><button type="submit">@(editing is null ? "Add search profile" : "Save search profile")</button>
 </EditForm>
}
<p><a href="/dashboard">Back to dashboard</a></p>
@code {
 private IReadOnlyList<SearchProfileDto> profiles=[]; private bool loading=true; private string? error; private Form form=new();
 protected override async Task OnInitializedAsync(){ await LoadAsync(); }
 private async Task LoadAsync(){ try { profiles=await Api.GetSearchProfilesAsync(); } catch { error="Search preferences could not be loaded."; } finally { loading=false; } }
 private Guid? editing; private async Task SaveAsync(){ try { SearchPreferencesDto p; if(editing is Guid id){var current=profiles.Single(x=>x.Id==id);var old=current.Preferences;p=old with { Categories=ReplaceFirst(old.Categories,form.Category),TargetRoles=ReplaceFirst(old.TargetRoles,form.Role),SourceMarkets=ReplaceFirst(old.SourceMarkets,form.Market)};await Api.UpdateSearchProfileAsync(id,new(form.Name,p,current.Version));}else p=new([form.Category],[form.Role],["remote"],[form.Market],null,[],[],[],[],[],[]); if(editing is null)await Api.CreateSearchProfileAsync(new(form.Name,p)); form=new();editing=null;await LoadAsync(); } catch { error="Search preferences could not be saved. Use a two-letter market code."; } }
 private async Task SetActiveAsync(SearchProfileDto item){try{await Api.SetSearchProfileActiveAsync(item,!item.IsActive);await LoadAsync();}catch{error="The search profile activation could not be saved.";}}
 private static IReadOnlyList<string> ReplaceFirst(IReadOnlyList<string> values,string replacement)=>values.Count==0?[replacement]:[replacement,..values.Skip(1)];
 private void Edit(SearchProfileDto item){editing=item.Id;form=new(){Name=item.Name,Category=item.Preferences.Categories.FirstOrDefault()??"",Role=item.Preferences.TargetRoles.FirstOrDefault()??"",Market=item.Preferences.SourceMarkets.FirstOrDefault()??"PT"};}
 private sealed class Form { [System.ComponentModel.DataAnnotations.Required] public string Name {get;set;}=""; [System.ComponentModel.DataAnnotations.Required] public string Category {get;set;}=""; [System.ComponentModel.DataAnnotations.Required] public string Role {get;set;}=""; [System.ComponentModel.DataAnnotations.Required, System.ComponentModel.DataAnnotations.StringLength(2,MinimumLength=2)] public string Market {get;set;}="PT"; }
}
