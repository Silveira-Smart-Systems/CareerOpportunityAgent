@page "/opportunities"
@attribute [Authorize]
@rendermode InteractiveServer
@using System.ComponentModel.DataAnnotations
@using COA.Web.Api
@using COA.Web.Components
@inject CoaApiClient CoaApiClient

<PageTitle>Opportunities</PageTitle>

<main class="opportunities-page">
    <header class="page-header">
        <div>
            <p class="eyebrow">Opportunity workspace</p>
            <h1>Opportunities</h1>
            <p>Import an opportunity and review its evidence-backed match.</p>
        </div>
        <a href="/dashboard">Back to dashboard</a>
    </header>

    <section class="import-panel" aria-labelledby="import-heading">
        <h2 id="import-heading">Import opportunity</h2>
        <EditForm Model="form" OnValidSubmit="ImportAsync">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <div class="form-grid">
                <div class="form-field form-field-wide">
                    <label for="opportunity-url">Original URL</label>
                    <InputText id="opportunity-url" @bind-Value="form.Url" type="url" autocomplete="url" />
                    <ValidationMessage For="@(() => form.Url)" />
                </div>
                <div class="form-field form-field-wide">
                    <label for="opportunity-title">Title</label>
                    <InputText id="opportunity-title" @bind-Value="form.Title" autocomplete="off" />
                    <ValidationMessage For="@(() => form.Title)" />
                </div>
                <div class="form-field form-field-wide">
                    <label for="opportunity-description">Description</label>
                    <InputTextArea id="opportunity-description" @bind-Value="form.Description" rows="6" />
                    <ValidationMessage For="@(() => form.Description)" />
                </div>
            </div>

            <button type="submit" disabled="@isImporting">
                @(isImporting ? "Importing…" : "Import opportunity")
            </button>
        </EditForm>
    </section>

    @if (!string.IsNullOrWhiteSpace(successMessage))
    {
        <p class="status-message success" role="status">@successMessage</p>
    }

    @if (importFailure is not null)
    {
        <section class="status-message error" role="alert">
            <strong>@importFailure.Heading</strong>
            <p>@importFailure.Message</p>
            @if (importFailure.RequiresSignIn)
            {
                <p><a href="/login">Sign in again</a></p>
            }
        </section>
    }

    <section aria-labelledby="imported-heading" aria-busy="@isLoading">
        <div class="section-heading">
            <div>
                <h2 id="imported-heading">Imported opportunities</h2>
                <p class="section-help">Score and eligibility answer different questions. Review the evidence before deciding.</p>
            </div>
            <button type="button" @onclick="LoadOpportunitiesAsync" disabled="@isLoading">Refresh</button>
        </div>

        @if (isLoading)
        {
            <p class="loading-state" role="status">Loading opportunities…</p>
        }
        else if (listFailure is not null)
        {
            <section class="list-error" role="alert" aria-labelledby="list-error-heading">
                <h3 id="list-error-heading">@listFailure.Heading</h3>
                <p>@listFailure.Message</p>
                @if (listFailure.RequiresSignIn)
                {
                    <p><a href="/login">Sign in again</a></p>
                }
                else if (listFailure.CanRetry)
                {
                    <button type="button" @onclick="LoadOpportunitiesAsync">Retry</button>
                }
            </section>
        }
        else if (opportunities.Count == 0)
        {
            <section class="empty-state" aria-labelledby="empty-heading">
                <h3 id="empty-heading">No imported opportunities yet</h3>
                <p>Use the form above to import an opportunity. Imported synthetic demos stay clearly labelled.</p>
            </section>
        }
        else
        {
            <div class="opportunity-list">
                @foreach (var item in opportunities)
                {
                    <article class="opportunity-card">
                        <div class="opportunity-summary">
                            <div>
                                <h3><a href="@($"/opportunities/{item.Opportunity.Id}")">@item.Opportunity.Title</a></h3>
                                @if (item.Opportunity.IsSynthetic)
                                {
                                    <p class="synthetic-label">Synthetic demo</p>
                                }
                                <p class="imported-at">Imported @item.Opportunity.ImportedAtUtc.ToLocalTime().ToString("g")</p>
                            </div>
                            <a class="external-link" href="@item.Opportunity.OriginalUrl" target="_blank" rel="noopener noreferrer">Open original <span class="visually-hidden">(opens in a new tab)</span></a>
                        </div>
                        <div class="assessment" aria-label="Match assessment">
                            <div>
                                <span class="assessment-label">Match score</span>
                                <strong class="score">@item.Assessment.Score.ToString("0.##")%</strong>
                            </div>
                            <div>
                                <span class="assessment-label">Required criteria</span>
                                <strong class="eligibility @(item.Assessment.Eligible ? "eligible" : "ineligible")">@OpportunityPresentation.EligibilityLabel(item.Assessment.Eligible)</strong>
                            </div>
                        </div>
                        <details>
                            <summary>Evidence by criterion (@item.Assessment.Criteria.Count)</summary>
                            <p class="evidence-help">Unknown means not proven; it is not treated as missing evidence.</p>
                            <ul class="criteria-list">
                                @foreach (var criterion in item.Assessment.Criteria)
                                {
                                    var evidence = OpportunityPresentation.Describe(criterion.Evidence);
                                    <li>
                                        <strong>@criterion.Code</strong>
                                        <span class="criterion-state @evidence.CssClass">@evidence.Label</span>
                                        <span>@evidence.Description</span>
                                        <span>(@criterion.Weight%)</span>
                                        @if (criterion.IsHardConstraint)
                                        {
                                            <span class="hard-constraint">Required</span>
                                        }
                                    </li>
                                }
                            </ul>
                        </details>
                    </article>
                }
            </div>
        }
    </section>
</main>

@code {
    private OpportunityForm form = new();
    private IReadOnlyList<ScoredOpportunity> opportunities = [];
    private bool isImporting;
    private bool isLoading = true;
    private RequestFailurePresentation? importFailure;
    private RequestFailurePresentation? listFailure;
    private string? successMessage;

    protected override Task OnInitializedAsync() => LoadOpportunitiesAsync();

    private async Task ImportAsync()
    {
        isImporting = true;
        importFailure = null;
        successMessage = null;

        try
        {
            await CoaApiClient.ImportOpportunityAsync(
                new OpportunityImportRequest(form.Url, form.Title, form.Description));
            form = new OpportunityForm();
            successMessage = "Opportunity imported successfully.";
            await LoadOpportunitiesAsync();
        }
        catch (Exception exception)
        {
            importFailure = OpportunityPresentation.DescribeRequestFailure(exception);
        }
        finally
        {
            isImporting = false;
        }
    }

    private async Task LoadOpportunitiesAsync()
    {
        isLoading = true;
        listFailure = null;

        try
        {
            opportunities = await CoaApiClient.GetOpportunitiesAsync();
        }
        catch (Exception exception)
        {
            listFailure = OpportunityPresentation.DescribeRequestFailure(exception);
        }
        finally
        {
            isLoading = false;
        }
    }

    private sealed class OpportunityForm
    {
        [Required, Url]
        public string Url { get; set; } = string.Empty;

        [Required, StringLength(200)]
        public string Title { get; set; } = string.Empty;

        [Required, StringLength(12000)]
        public string Description { get; set; } = string.Empty;
    }
}
