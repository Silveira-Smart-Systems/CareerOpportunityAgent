@page "/profile"
@attribute [Authorize]
@rendermode InteractiveServer
@using COA.Web.Api
@inject CoaApiClient Api

<PageTitle>Career profile</PageTitle>
<h1>Career profile</h1>
@if (loading) { <p role="status">Loading profile…</p> }
else {
    @if (!string.IsNullOrEmpty(error)) { <p role="alert">@error</p> }
    @if (profile is null) { <p>No career profile exists yet.</p> }
    <EditForm Model="form" OnValidSubmit="SaveAsync"><DataAnnotationsValidator /><ValidationSummary />
        <label>Headline <InputText @bind-Value="form.Headline" /></label>
        <label><InputCheckbox @bind-Value="form.RemoteOnly" /> Remote only</label>
        <button type="submit">Save profile</button>
    </EditForm>
}
<p><a href="/dashboard">Back to dashboard</a></p>

@code {
    private CareerProfileDto? profile; private bool loading = true; private string? error; private Form form = new();
    protected override async Task OnInitializedAsync() { try { profile = await Api.GetProfileAsync(); if (profile is not null) form = new() { Headline = profile.Headline, RemoteOnly = profile.Preferences.RemoteOnly }; } catch { error = "The profile could not be loaded."; } finally { loading = false; } }
    private async Task SaveAsync() { try { var existing = profile?.Preferences; var preferences = new CareerPreferencesDto(form.RemoteOnly ? "remote" : existing?.PreferredArrangement ?? "remote", form.RemoteOnly, existing?.MinimumHourlyRate, existing?.Currency, form.RemoteOnly ? 0 : existing?.MaximumOfficeDaysPerWeek); profile = await Api.SaveProfileAsync(new(form.Headline, profile?.Evidence ?? [], preferences, profile?.Version), profile is not null); } catch { error = "The profile could not be saved. Check the values and try again."; } }
    private sealed class Form { [System.ComponentModel.DataAnnotations.Required, System.ComponentModel.DataAnnotations.StringLength(200)] public string Headline { get; set; } = string.Empty; public bool RemoteOnly { get; set; } = true; }
}
